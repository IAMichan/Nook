{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "description": "__MSG_appDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/nook-16.png",
    "32": "icons/nook-32.png",
    "48": "icons/nook-48.png",
    "128": "icons/nook-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/nook-16.png",
      "32": "icons/nook-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "scripting", "sidePanel", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
