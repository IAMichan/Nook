    "Follow your agents, approve what they ask, start new work, and chat with Nook.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge deine Agenten, gib frei, was sie fragen, starte neue Arbeit und chatte mit Nook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a tus agentes, aprueba lo que piden, inicia trabajo nuevo y chatea con Nook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez vos agents, approuvez leurs demandes, lancez du travail et discutez avec Nook."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg je agents, keur goed wat ze vragen, start nieuw werk en chat met Nook."
