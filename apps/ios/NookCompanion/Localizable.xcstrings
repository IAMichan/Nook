      }
    },
    "Nook cannot read the notifications on your Mac: give it Full Disk Access in System Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook kann die Mitteilungen auf deinem Mac nicht lesen: Gib ihm in den Systemeinstellungen Festplattenvollzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook no puede leer las notificaciones de tu Mac: dale acceso total al disco en Ajustes del Sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook ne peut pas lire les notifications de votre Mac : accordez-lui l’accès complet au disque dans Réglages Système."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook kan de meldingen op je Mac niet lezen: geef het Volledige schijftoegang in Systeeminstellingen."
          }
        }
      }
    },
    "Nook checks out %@ in a worktree of its own, where your Mac has %@, and starts the agent there. It asks before anything risky, as every session started from your iPhone." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook haalt %1$@ uit in een eigen worktree, waar je Mac %2$@ heeft, en start daar de agent. Het vraagt eerst bij alles wat riskant is, zoals elke sessie vanaf je iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook checkt %1$@ in einem eigenen Worktree aus, wo dein Mac %2$@ hat, und startet dort den Agenten. Bei allem Riskanten fragt er zuerst, wie jede Sitzung von deinem iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook extrait %1$@ dans un worktree dédié, là où ton Mac a %2$@, et y lance l'agent. Il demande avant tout ce qui est risqué, comme chaque session lancée depuis ton iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook extrae %1$@ en un worktree propio, donde tu Mac tiene %2$@, y inicia allí al agente. Pregunta antes de cualquier cosa arriesgada, como cada sesión iniciada desde tu iPhone."
          }
        }
      }
    },
    "Nook has no brain set up on your Mac yet: choose one in Nook › Settings." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook hat auf deinem Mac noch kein Gehirn: Wähle eines in Nook › Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook aún no tiene un cerebro en tu Mac: elige uno en Nook › Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook n’a pas encore de cerveau sur votre Mac : choisissez-en un dans Nook › Réglages."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook heeft nog geen brein op je Mac: kies er een in Nook › Instellingen."
          }
        }
      }
    },
