    "Open Nook on your computer: on a Mac, Settings › iPhone companion; on Windows or Linux, Settings › Companion. Turn it on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Nook auf deinem Computer: auf einem Mac Einstellungen › iPhone-Companion, unter Windows oder Linux Einstellungen › Companion. Schalte ihn ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Nook en tu ordenador: en un Mac, Ajustes › Companion de iPhone; en Windows o Linux, Ajustes › Companion. Actívalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Nook sur votre ordinateur : sur un Mac, Réglages › Compagnon iPhone ; sous Windows ou Linux, Réglages › Companion. Activez-le."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Nook op je computer: op een Mac Instellingen › iPhone-companion, op Windows of Linux Instellingen › Companion. Zet hem aan."
          }
        }
      }
    },
    "Choose ‘Pair an iPhone’ on a Mac, or ‘Pair a phone’ on Windows or Linux: Nook shows a code for five minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle ‚iPhone koppeln‘ auf einem Mac oder ‚Telefon koppeln‘ unter Windows oder Linux: Nook zeigt fünf Minuten lang einen Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige «Vincular un iPhone» en un Mac, o «Emparejar un teléfono» en Windows o Linux: Nook muestra un código durante cinco minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Associer un iPhone » sur un Mac, ou « Appairer un téléphone » sous Windows ou Linux : Nook affiche un code pendant cinq minutes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies ‘Koppel een iPhone’ op een Mac, of ‘Koppel een telefoon’ op Windows of Linux: Nook toont vijf minuten een code."
          }
        }
      }
    },
    "Scan it here. Your phone and computer need to be on the same Wi‑Fi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne ihn hier. Telefon und Computer müssen im selben WLAN sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanéalo aquí. Tu teléfono y tu ordenador deben estar en la misma Wi‑Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
