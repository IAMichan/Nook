    "It leaves Nook's Chats until a new message comes in. Nothing changes in the app itself." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij verdwijnt uit Chats in Nook tot er een nieuw bericht binnenkomt. In de app zelf verandert niets."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verschwindet aus den Chats in Nook, bis eine neue Nachricht kommt. In der App selbst ändert sich nichts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il quitte les Chats de Nook jusqu’à l’arrivée d’un nouveau message. Rien ne change dans l’app elle-même."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale de los Chats de Nook hasta que llegue un mensaje nuevo. En la propia app no cambia nada."
          }
        }
      }
    },
    "It waits with your review and goes when you send it." : {
      "localizations" : {
