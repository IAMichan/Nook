          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que envíes aún no se envía: espera en este iPhone y sale en cuanto tu Mac vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
