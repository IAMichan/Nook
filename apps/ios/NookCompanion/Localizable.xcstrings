    "Nook has no brain set up on your Mac yet: choose one in Nook › Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook hat auf deinem Mac noch kein Gehirn: Wähle eines in Nook › Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook aún no tiene un cerebro en tu Mac: elige uno en Nook › Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook n’a pas encore de cerveau sur votre Mac : choisissez-en un dans Nook › Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook heeft nog geen brein op je Mac: kies er een in Nook › Instellingen."
          }
        }
      }
    },
    "Nook made a plan, draft or chart: see it on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook hat einen Plan, Entwurf oder ein Diagramm erstellt: Sieh es dir auf deinem Mac an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook creó un plan, borrador o gráfico: míralo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook a créé un plan, un brouillon ou un graphique : consultez-le sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook maakte een plan, concept of grafiek: bekijk het op je Mac."
          }
        }
      }
    },
    "Nook uses your account, model and permissions for this agent. Anything risky still waits for your approval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook verwendet dein Konto, Modell und deine Berechtigungen für diesen Agenten. Alles Riskante wartet weiterhin auf deine Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook usa tu cuenta, modelo y permisos para este agente. Todo lo arriesgado sigue esperando tu aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook utilise votre compte, votre modèle et vos autorisations pour cet agent. Tout ce qui est risqué attend toujours votre accord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nook gebruikt je account, model en rechten voor deze agent. Alles wat riskant is wacht nog steeds op je goedkeuring."
          }
        }
      }
    },
    "Not possible from your phone: open it on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geht nicht vom iPhone aus: Öffne es auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es posible desde tu teléfono: ábrelo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible depuis votre téléphone : ouvrez-le sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat kan niet vanaf je telefoon: open het op je Mac."
          }
        }
      }
    },
