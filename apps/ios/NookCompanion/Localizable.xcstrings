          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan hem hier. Je telefoon en computer moeten op hetzelfde wifi zitten."
          }
        }
      }
    },
    "Pairing failed: %@ The code works once, for five minutes; make a new one on your computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppeln fehlgeschlagen: %@ Der Code gilt einmal, fünf Minuten lang; erstelle auf deinem Computer einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vinculación falló: %@ El código sirve una vez, durante cinco minutos; crea uno nuevo en tu ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumelage échoué : %@ Le code fonctionne une fois, pendant cinq minutes ; créez-en un nouveau sur votre ordinateur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppelen mislukt: %@ De code werkt één keer, vijf minuten lang; maak op je computer een nieuwe."
          }
        }
      }
    },
    "This iPhone is paired with as many computers as it can keep. Unpair one first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone ist schon mit so vielen Computern gekoppelt, wie es sich merken kann. Entkopple zuerst einen."
          }
        },
        "es" : {
          "stringUnit" : {
