        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión ya no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session n’existe plus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
