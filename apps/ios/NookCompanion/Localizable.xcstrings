    "That is not a valid pairing code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein gültiger Kopplungscode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese no es un código de vinculación válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas un code de jumelage valide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat is geen geldige koppelcode."
          }
        }
      }
    },
    "The clocks of your phone and your Mac are too far apart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhren deines iPhones und deines Macs weichen zu stark voneinander ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los relojes de tu teléfono y tu Mac están demasiado desfasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horloges de votre téléphone et de votre Mac sont trop décalées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klok van je telefoon en je Mac lopen te ver uit elkaar."
          }
        }
      }
    },
    "The connection was lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été perdue."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbinding werd verbroken."
          }
        }
      }
    },
    "The key could not be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel konnte nicht gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé n’a pas pu être enregistrée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel kon niet worden bewaard."
          }
        }
      }
    },
    "This is risky or unknown: it can only be allowed on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist riskant oder unbekannt: Erlauben geht nur auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es arriesgado o desconocido: solo se puede permitir en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est risqué ou inconnu : l’autorisation n’est possible que sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is riskant of onbekend: toestaan kan alleen op je Mac."
          }
        }
      }
    },
    "This session is gone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung gibt es nicht mehr."
