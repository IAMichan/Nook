    "On its own branch (worktree)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf eigenem Branch (Worktree)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su propia rama (worktree)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur sa propre branche (worktree)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een eigen branch (worktree)"
          }
        }
      }
    },
    "On your Mac, turn on the iPhone companion in Nook › Settings and choose ‘Pair an iPhone’. Then scan the code, or paste the link. Your phone and Mac must be on the same Wi‑Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte auf deinem Mac in Nook › Einstellungen den iPhone-Begleiter ein und wähle „iPhone koppeln“. Scanne dann den Code oder füge den Link ein. Dein iPhone und dein Mac müssen im selben WLAN sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, activa el acompañante para iPhone en Nook › Ajustes y elige “Vincular un iPhone”. Luego escanea el código o pega el enlace. Tu teléfono y tu Mac deben estar en la misma red Wi‑Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, activez le compagnon iPhone dans Nook › Réglages et choisissez « Jumeler un iPhone ». Scannez ensuite le code, ou collez le lien. Votre téléphone et votre Mac doivent être sur le même Wi‑Fi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet op je Mac in Nook › Instellingen de iPhone-metgezel aan en kies ‘Koppel een iPhone’. Scan dan de code, of plak de link. Je telefoon en Mac moeten op hetzelfde wifi zitten."
          }
        }
      }
    },
    "Pair": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vincular"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumeler"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel"
          }
        }
      }
    },
    "Pairing failed: %@ The code works once, for five minutes; make a new one on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln fehlgeschlagen: %@ Der Code gilt einmal, fünf Minuten lang; erstelle auf deinem Mac einen neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vinculación falló: %@ El código sirve una vez, durante cinco minutos; crea uno nuevo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelage échoué : %@ Le code fonctionne une fois, pendant cinq minutes ; créez-en un nouveau sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen mislukt: %@ De code werkt één keer, vijf minuten lang; maak op je Mac een nieuwe."
          }
        }
      }
    },
