          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel"
          }
        }
      }
    },
    "Pairing failed: %@ The code works once, for five minutes; make a new one on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln fehlgeschlagen: %@ Der Code gilt einmal, fünf Minuten lang; erstelle auf deinem Mac einen neuen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vinculación falló: %@ El código sirve una vez, durante cinco minutos; crea uno nuevo en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelage échoué : %@ Le code fonctionne une fois, pendant cinq minutes ; créez-en un nouveau sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppelen mislukt: %@ De code werkt één keer, vijf minuten lang; maak op je Mac een nieuwe."
          }
        }
      }
    },
    "Push notifications are not ready on your Mac yet (Settings › iPhone companion).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Push-Mitteilungen sind auf deinem Mac noch nicht eingerichtet (Einstellungen › iPhone-Begleiter)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones push aún no están listas en tu Mac (Ajustes › Acompañante para iPhone)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications push ne sont pas encore prêtes sur votre Mac (Réglages › Compagnon iPhone)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pushmeldingen staan op je Mac nog niet klaar (Instellingen › iPhone-metgezel)."
