    "Ask Nook anything: your calendar, mail, notes, or the web. Plans and drafts wait for your approval on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Nook, was du willst: Kalender, Mail, Notizen oder das Web. Pläne und Entwürfe warten auf deinem Mac auf deine Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a Nook lo que quieras: tu calendario, correo, notas o la web. Los planes y borradores esperan tu aprobación en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez ce que vous voulez à Nook : agenda, mails, notes ou le web. Les plans et brouillons attendent votre accord sur votre Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Nook wat je wilt: je agenda, mail, notities of het web. Plannen en concepten wachten op je goedkeuring op je Mac."
          }
        }
      }
    },
