    },
    "Nook can only read this chat: answer it in its own app." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook kann diesen Chat nur lesen: Antworte in seiner eigenen App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nook solo puede leer este chat: respóndelo en su propia app."
          }
        },
        "fr" : {
          "stringUnit" : {
