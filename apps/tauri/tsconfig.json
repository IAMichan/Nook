{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@nook/web-ui/*": ["../../packages/web-ui/src/*"],
      "svelte": ["./node_modules/svelte"],
      "svelte/*": ["./node_modules/svelte/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../../packages/web-ui/src/**/*.ts", "../../packages/web-ui/src/**/*.svelte"]
}
