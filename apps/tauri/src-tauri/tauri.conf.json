{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nook",
  "version": "0.1.0",
  "identifier": "nl.imdigital.nook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nook",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#19191e",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: http://localhost:*; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Michan van der Hoek",
    "homepage": "https://github.com/IAMichan/Nook",
    "shortDescription": "Your buddy for everything that needs your attention",
    "longDescription": "Nook is the one calm place for everything that needs your attention: people, coding agents, music, your calendar and more. You keep the overview and steer instead of chase, and nothing happens without your OK.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "windows/nsis-header.bmp",
        "installMode": "currentUser",
        "languages": ["English", "Dutch", "German", "French", "Spanish"],
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "windows/wix-banner.bmp",
        "dialogImagePath": "windows/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] }
    }
  }
}
