# Editor settings that match the code as it is: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Swift, Rust (see apps/tauri/rustfmt.toml), Python, Kotlin, and XML keep the default of 4 spaces.

[*.{svelte,ts,js,mjs,cjs,json,css,html,yml,yaml,sh}]
indent_size = 2

[*.go]
# gofmt
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

# Generated by Tauri for the Android build; left as generated.
[apps/tauri/src-tauri/gen/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
